# =============================================================================
# INCEPTION - Environment Variables Template
# =============================================================================
# Copy this file to .env and replace values with your own
# NOTE: Replace 'login' with your 42 username throughout this file

# Domain Configuration
DOMAIN_NAME=login.42.fr

# =============================================================================
# MySQL/MariaDB Configuration
# =============================================================================
MYSQL_HOST=mariadb
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
# Password is stored in secrets/db_password.txt

# =============================================================================
# WordPress Configuration
# =============================================================================
WP_TITLE=Inception

# WordPress Admin (username CANNOT contain 'admin')
WP_ADMIN_USER=boss
WP_ADMIN_EMAIL=boss@login.42.fr

# WordPress Regular User
WP_USER=author
WP_USER_EMAIL=author@login.42.fr

# =============================================================================
# User for volume paths
# =============================================================================
# This should match your system username
USER=login
